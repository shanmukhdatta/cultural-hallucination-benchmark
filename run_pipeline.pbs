#!/bin/bash
# ==============================================================================
# NIT Jalandhar HPC (Nvidia H100) — Batch Job Submission Script
# Adheres strictly to NITJ HPC User Manual v2.0 & Lab Queue Guidelines:
# - Queue: workq (GPU-accelerated partition)
# - Policy: Exactly 1 GPU instance per user
# - Storage: Uses /Data folder for model weights (never home directory)
# - Single Job: Runs inference -> judge -> embed drift sequentially
# ==============================================================================

#PBS -N dravidian_drift
#PBS -q workq
#PBS -l select=1:ncpus=32:ngpus=1
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o output_pipeline.log

# Exit immediately if any command encounters an unhandled error
set -e

# ------------------------------------------------------------------------------
# 1. Navigate to the job working directory
# ------------------------------------------------------------------------------
cd "$PBS_O_WORKDIR"
echo "======================================================================"
echo "Job ID             : $PBS_JOBID"
echo "Compute Node       : $(hostname)"
echo "Working Directory  : $(pwd)"
echo "Start Time         : $(date)"
echo "======================================================================"

# ------------------------------------------------------------------------------
# 2. NITJ Storage Policy: Cache Redirection to /Data folder
# (Prevents quota exhaustion and automatic deletion in /home)
# ------------------------------------------------------------------------------
export HF_HOME="/Data/${USER}/hf_cache"
mkdir -p "$HF_HOME"
echo "Hugging Face Cache : $HF_HOME"

# ------------------------------------------------------------------------------
# 3. Environment & Python Priority (Mandated by NITJ HPC Manual)
# ------------------------------------------------------------------------------
# Force conda environment priority (prevents loading conflicting ~/.local packages)
export PYTHONNOUSERSITE=1

# Initialize Conda for non-interactive PBS shell
if [ -f "/apps/compilers/anaconda3/etc/profile.d/conda.sh" ]; then
    source /apps/compilers/anaconda3/etc/profile.d/conda.sh
elif [ -f "$HOME/anaconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/anaconda3/etc/profile.d/conda.sh"
elif [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

# Activate your custom conda environment (change name if different)
conda activate dravidian_env || echo "Please ensure 'dravidian_env' is created"

# ------------------------------------------------------------------------------
# 4. H100 MIG Instance Setup (Mandated by NITJ HPC Manual)
# Automatically selects the first available MIG slice if not manually exported
# ------------------------------------------------------------------------------
if [ -z "$CUDA_VISIBLE_DEVICES" ]; then
    DETECTED_MIG=$(nvidia-smi -L 2>/dev/null | grep -o 'MIG-[a-f0-9-]*' | head -n 1 || true)
    if [ -n "$DETECTED_MIG" ]; then
        export CUDA_VISIBLE_DEVICES="$DETECTED_MIG"
        echo "Auto-detected H100 MIG Device: $CUDA_VISIBLE_DEVICES"
    fi
fi

echo "Active GPU Devices Check:"
nvidia-smi -L || true
echo "----------------------------------------------------------------------"

# ------------------------------------------------------------------------------
# 5. API Keys (Export in your shell before qsub, or enter here)
# ------------------------------------------------------------------------------
export HF_TOKEN="${HF_TOKEN:-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}"
export OPENAI_API_KEY="${OPENAI_API_KEY:-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}"

# ------------------------------------------------------------------------------
# 6. Step 1: Model Inference (H100 GPU Accelerated)
# 5 models x 200 prompts = 1,000 records -> results/checkpoints/raw_responses.json
# ------------------------------------------------------------------------------
echo ""
echo ">>> [1/3] STARTING STEP 1: Model Inference on H100 GPU <<<"
python3 code/01_run_inference.py
echo ">>> [1/3] STEP 1 FINISHED: raw_responses.json generated <<<"

# ------------------------------------------------------------------------------
# 7. Step 2: Cultural Stance Scoring (GPT-4o Judge)
# Uses API + GPU Keepalive Shield so cluster watchdog does not terminate it
# ------------------------------------------------------------------------------
echo ""
echo ">>> [2/3] STARTING STEP 2: GPT-4o Cultural Stance Judge <<<"
python3 code/02_judge_responses.py
echo ">>> [2/3] STEP 2 FINISHED: judge_scores.json generated <<<"

# ------------------------------------------------------------------------------
# 8. Step 3: Semantic Embedding Distance (LaBSE on GPU)
# ------------------------------------------------------------------------------
echo ""
echo ">>> [3/3] STARTING STEP 3: LaBSE Semantic Drift Calculation <<<"
python3 code/03_embed_distance.py
echo ">>> [3/3] STEP 3 FINISHED: embed_distances.json generated <<<"

echo ""
echo "======================================================================"
echo "ALL PIPELINE STEPS COMPLETED SUCCESSFULLY ON H100 GPU"
echo "End Time: $(date)"
echo "======================================================================"
